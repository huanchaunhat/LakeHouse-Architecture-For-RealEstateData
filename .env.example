# Copy this file to .env before starting the stack.
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BUCKET=lakehouse

METASTORE_MYSQL_ROOT_PASSWORD=change-this-metastore-root-password
METASTORE_MYSQL_DATABASE=metastore
METASTORE_MYSQL_USER=hive
METASTORE_MYSQL_PASSWORD=change-this-hive-password

AIRFLOW_UID=1000
AIRFLOW_MYSQL_ROOT_PASSWORD=change-this-airflow-root-password
AIRFLOW_MYSQL_DATABASE=airflow
AIRFLOW_MYSQL_USER=airflow
AIRFLOW_MYSQL_PASSWORD=change-this-airflow-password
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-this-airflow-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com

SUPERSET_SECRET_KEY=replace-with-a-long-random-secret
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=change-this-superset-admin-password
SUPERSET_ADMIN_EMAIL=admin@example.com

SPARK_MASTER_URL=spark://spark-master:7077
SPARK_WORKER_MEMORY=2G
SPARK_WORKER_CORES=2

# S3-compatible credentials used by Spark/Airflow jobs.
AWS_ACCESS_KEY_ID=lakehouse
AWS_SECRET_ACCESS_KEY=change-this-minio-password
AWS_ENDPOINT_URL=http://minio:9000
AWS_REGION=us-east-1
